# Backend URL. In development, app uses http://127.0.0.1:5000 by default (no proxy).
# Set to empty string to use the dev-server proxy instead: REACT_APP_API_URL=
# REACT_APP_API_URL=http://127.0.0.1:5000
#
# Production (Vercel → Render): build with API origin, e.g.
# REACT_APP_API_URL=https://nextgen-mis.onrender.com
# Frontend: https://nextgen-mis.vercel.app  |  API docs: https://nextgen-mis.onrender.com/
#
# Session: 60-minute idle + JWT (default). Set to 1 to disable idle/401 rules for local demo:
# REACT_APP_DISABLE_SESSION_EXPIRY=1
